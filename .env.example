# Copy to .env (one directory ABOVE the public web root if your Xneelo plan
# allows it; otherwise place it here and keep .htaccess's deny rule for it).
# Never commit the real .env file.

APP_ENV=production
APP_URL=https://www.aloecredit.co.za
APP_NAME="Aloe Credit"

DB_HOST=localhost
DB_NAME=changeme
DB_USER=changeme
DB_PASS=changeme

# Xneelo shared hosting: use your domain's local mail server settings from
# cPanel > Email Accounts, or an SMTP relay (SendGrid, Mailgun, etc.).
MAIL_FROM=no-reply@aloecredit.co.za
MAIL_FROM_NAME="Aloe Credit"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

SESSION_NAME=aloe_session
HIBP_LEAK_CHECK=1
